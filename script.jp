  "h": "ᚺ",
  "ĥ": "ᚺ^",
  "i": "ᛁ",
  "j": "ᚼ",
  "ĵ": "ᚼ^",
  "k": "K",
  "l": "L",
  "m": "ᛗ",
  "n": "ᚾ",
  "o": "ᛟ",
  "p": "ᛈ",
  "q": "ᚦ",
  "r": "ᚱ",
  "s": "ᛋ",
  "ŝ": "ᛋ^",
  "t": "ᛏ",
  "u": "ᚢ",
  "ŭ": "ᚢ^",
  "v": "V",
  "w": "ᚹ",
  "x": "ᛝ",
